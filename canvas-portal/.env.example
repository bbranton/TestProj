# Copy this file to .env and fill in real values. .env is git-ignored:
# never commit tokens or secrets (requirements A-3).

# Canvas test account, for local manual tests only. CI uses recorded data.
CANVAS_BASE_URL=https://myschool.instructure.com
CANVAS_TEST_TOKEN=

# Sign in with Google (design section 5), from the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
